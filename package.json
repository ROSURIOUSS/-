{
  "name": "loria-web",
  "version": "2.3.0",
  "description": "Лория — хардкорная ИИ-RPG с суверенным Гейм-Мастером, аудитором состояния и памятью мира",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node scripts/launcher.js",
    "serve": "node server/index.js",
    "start:web": "node server/index.js",
    "dev": "node --watch server/index.js",
    "doctor": "node scripts/doctor.js",
    "bot": "node server/telegram.js",
    "test": "node scripts/selftest.js",
    "e2e": "node scripts/integration.js",
    "check": "npm test && npm run bot:test && npm run e2e",
    "bot:test": "node scripts/bot-test.js",
    "app": "node scripts/launcher.js",
    "build:exe": "node scripts/build-exe.mjs"
  },
  "devDependencies": {
    "@webviewjs/webview": "^0.4.9",
    "esbuild": "^0.25.10",
    "pe-library": "^1.0.1",
    "postject": "^1.0.0-alpha.6",
    "resedit": "^3.1.0"
  }
}
