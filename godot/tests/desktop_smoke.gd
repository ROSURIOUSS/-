extends SceneTree
## Run via `godot --headless --path godot --script res://tests/desktop_smoke.gd
## -- --fixture=/absolute/path/snapshot.json`. This is NOT the app main scene.
const PlanetView = preload("res://world_view.gd")
const PlanetGeometry = preload("res://planet_geometry.gd")
const Bridge = preload("res://python_bridge.gd")
const Application = preload("res://main.gd")

func _initialize() -> void:
	call_deferred("_run")

func _run() -> void:
	var fixture := ""
	var screenshots := ""
	for arg in OS.get_cmdline_user_args():
		if arg.begins_with("--fixture="):
			fixture = arg.trim_prefix("--fixture=")
		if arg.begins_with("--screenshots="):
			screenshots = arg.trim_prefix("--screenshots=")
	assert(not fixture.is_empty(), "Supply --fixture=... generated by tools/render_fixture.py")
	var data: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(fixture))
	print("[SMOKE] geometry")
	var geometry := PlanetGeometry.new()
	geometry.configure(data)
	for uv: Vector2 in [Vector2(0.02, 0.2), Vector2(0.5, 0.5), Vector2(0.97, 0.9)]:
		assert(geometry.coordinates(geometry.direction(uv)).distance_to(uv) < 0.00001)
		var ray: Vector3 = -PlanetGeometry.direction(uv)
		var hit: Vector2 = geometry.pick(-ray * 20.0, ray)
		assert(hit.distance_to(uv) < 0.001)
	assert(absf(geometry.radius(Vector2(0, 0)) - geometry.radius(Vector2(0.5, 0))) < 0.00001)
	var view := PlanetView.new()
	view.size = Vector2(960, 640)
	root.add_child(view)
	await process_frame
	view.update_world(data)
	await process_frame
	assert(view._ground.mesh.get_surface_count() == 1)
	assert(view._bodies.multimesh.instance_count == data["population"])
	print("[SMOKE] organism geometry")
	var first: Dictionary = data["creatures"][0]
	var rendered := view._bodies.multimesh.get_instance_transform(0)
	assert(absf(rendered.basis.z.length() - 0.005 * float(first["size"]) * float(first["elongation"])) < 0.00001)
	assert(absf(view._bodies.multimesh.get_instance_custom_data(0).b - float(first["armor"])) < 0.005)
	# Body, organelles, tails, ground clearance and selection share the same shrink.
	var visual_size := float(first["size"]) * 0.25
	var girth := 1.0 / sqrt(float(first["elongation"]))
	assert(absf(rendered.basis.x.length() - 0.012 * girth * visual_size) < 0.00001)
	var nucleus := view._nuclei.multimesh.get_instance_transform(0)
	assert(absf(nucleus.basis.x.length() - 0.0045 * visual_size) < 0.00001)
	var tail := view._tails.multimesh.get_instance_transform(0)
	assert(absf(tail.basis.y.length() - 0.018 * visual_size) < 0.00001)
	var uv := Vector2(first["x"], first["y"]) / Vector2(geometry.width, geometry.height)
	assert(absf(rendered.origin.length() - geometry.radius(uv) - 0.016 * visual_size) < 0.00001)
	view.select_creature(int(first["id"]))
	view._process(0.0)
	assert(view._selection.visible)
	assert(absf(view._selection.basis.x.length() - girth * visual_size) < 0.00001)
	assert(absf(view._selection.position.distance_to(rendered.origin) - 0.007 * visual_size) < 0.00001)
	# Shortest-arc turning, measured-motion shader data, and frozen animation on pause.
	var visual: Dictionary = view._visuals[int(first["id"])]
	var real_heading: float = visual["target_heading"]
	visual["heading"] = PI - 0.1
	visual["target_heading"] = -PI + 0.1
	var phase_before: float = visual["phase"]
	view.snapshot["paused"] = false
	view._process(0.05)
	assert(absf(wrapf(float(visual["heading"]), -PI, PI)) > 3.0)
	assert(float(visual["phase"]) != phase_before)
	assert(absf(view._tails.multimesh.get_instance_custom_data(0).a - float(visual["motion"])) < 0.005)
	view.snapshot["paused"] = true
	var frozen_phase: float = visual["phase"]
	view._process(0.1)
	assert(float(visual["phase"]) == frozen_phase)
	visual["target_heading"] = real_heading
	if not screenshots.is_empty():
		await create_timer(1.0).timeout
		await _capture(view, screenshots, "orbit")
	assert(view.brush_kind == "observe")
	view.set_brush("warm", 3.0, 0.5, 4)
	assert(view.brush_kind == "warm" and view.brush_radius == 3.0)
	view._painting = true
	view._brush_pending = true
	view.finish_brush(false)
	assert(not view._painting and not view._brush_pending)
	view._painting = true
	view._notification(Node.NOTIFICATION_WM_WINDOW_FOCUS_OUT)
	assert(not view._painting)
	view.set_brush("observe", 2.5, 0.6, 5)
	assert(view._temperature_texture != null)
	view.layer = 4
	assert(view._ground_material.get_shader_parameter("layer") == 4)
	view.layer = 0
	print("[SMOKE] camera")
	view.set_scale_level(2)
	assert(absf(view._target_altitude - 0.1) < 0.001)
	assert(view.selected_id >= 0)
	if not screenshots.is_empty():
		await create_timer(1.8).timeout
		await _capture(view, screenshots, "micro")
	view.set_scale_level(0)
	assert(view._target_altitude == 13.0)
	var wheel := InputEventMouseButton.new()
	wheel.button_index = MOUSE_BUTTON_WHEEL_UP
	wheel.pressed = true
	wheel.position = Vector2(480, 320)
	view._gui_input(wheel)
	assert(view._target_altitude < 13.0)
	# Both snapshots come from the Python model, including a real erase intervention.
	var family_test: Dictionary = data["_lineage_test"]
	view.select_creature(int(family_test["selected"]), true)
	view.set_lineage_tracking(true)
	var after: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(family_test["after"]))
	view.update_world(after)
	assert(view.selected_id != int(family_test["selected"]))
	assert(view.tracked_lineage == int(family_test["lineage"]) and view._follow)
	assert(int(view._visuals[view.selected_id]["data"]["lineage"]) == int(family_test["lineage"]))
	assert(view.focus_lineage(int(family_test["lineage"])))
	assert(not view.focus_lineage(-12345))
	view.clear_population_visuals()
	assert(view.tracked_lineage == -1)
	view.update_world(data)
	assert(view._weather_texture != null)
	var weather_image := view._weather_texture.get_image()
	assert(absf(weather_image.get_pixel(0, 0).g - float(data["rain"][0])) < 0.005)
	assert(absf(float(view._cloud_material.get_shader_parameter("model_day")) - float(data["day"])) < 0.001)
	view.layer = 5
	assert(view._ground_material.get_shader_parameter("layer") == 5)
	view.layer = 6
	assert(view._ground_material.get_shader_parameter("layer") == 6)
	view.layer = 0
	var old_longitude := view._longitude
	var old_latitude := view._latitude
	var old_altitude := view._altitude
	var rainy_tile: int = data["rain"].find(data["rain"].max())
	view._longitude = ((rainy_tile % 80 + 0.5) / 80.0 - 0.5) * TAU
	view._latitude = (0.5 - (floori(rainy_tile / 80.0) + 0.5) / 48.0) * PI
	view._altitude = 0.1
	view._rain_timer = 0.0
	var rain_clock := view._rain_clock
	view._update_rain_effect(0.1)
	assert(view._rain.multimesh.instance_count > 0 and view._rain.multimesh.instance_count <= 256)
	assert(view._rain_clock == rain_clock, "Fixture is paused; rain effects must freeze")
	view.show_weather = false
	view._update_rain_effect(0.1)
	assert(not view._rain.visible)
	view.show_weather = true
	view._longitude = old_longitude
	view._latitude = old_latitude
	view._altitude = old_altitude
	view._rain_timer = 0.0
	print("[SMOKE] bundled worker")
	var bridge := Bridge.new()
	root.add_child(bridge)
	var extracted := bridge._unpack_bundled_core()
	assert(not extracted.is_empty() and FileAccess.file_exists(extracted))
	var received: Dictionary = {}
	var failures: Array[String] = []
	bridge.state_received.connect(func(state: Dictionary): received.assign(state))
	bridge.failed.connect(func(message: String): failures.append(message))
	var executable := OS.get_environment("BIOSPHERE_PYTHON")
	if executable.is_empty():
		executable = "python3"
	bridge._launch(executable, PackedStringArray(["-u", extracted]))
	var deadline := Time.get_ticks_msec() + 15000
	while received.is_empty() and failures.is_empty() and Time.get_ticks_msec() < deadline:
		await process_frame
	assert(failures.is_empty(), str(failures))
	assert(received.has("moisture") and received.has("autosaves"), "Bundled core did not return the recovery protocol")
	bridge.submit("world", {"population": 8})
	while int(received.get("population", 0)) != 8 and Time.get_ticks_msec() < deadline:
		await process_frame
	assert(int(received["population"]) == 8)
	var completions: Dictionary = {}
	bridge.command_finished.connect(func(command: String, ok: bool, message: String): completions[command] = [ok, message])
	var original_day := 0.0
	var original_state: Dictionary = {}
	for request: Array in [["control", {"paused": true}], ["brush", {"kind": "warm", "x": 40.5, "y": 24.5, "stroke": 1}], ["single_step", {}], ["undo", {}], ["brush", {"kind": "rain", "x": 40.5, "y": 24.5, "stroke": 2}], ["single_step", {}], ["undo", {}]]:
		var command: String = request[0]
		completions.erase(command)
		bridge.submit(command, request[1])
		deadline = Time.get_ticks_msec() + 15000
		while not completions.has(command) and failures.is_empty() and Time.get_ticks_msec() < deadline:
			await process_frame
		assert(completions.has(command) and completions[command][0], str(completions))
		if command == "control":
			original_day = float(received["day"])
			original_state = received.duplicate(true)
		elif command == "brush":
			assert(received["sandbox"]["can_undo"])
			if request[1]["kind"] == "rain":
				assert(received["rain"] != original_state["rain"])
			else:
				assert(received["temperature_bias"].max() > 0)
		elif command == "single_step":
			assert(received["paused"] and absf(float(received["day"]) - original_day - 0.25) < 0.001)
		elif command == "undo":
			assert(received["paused"] and not received["sandbox"]["can_undo"])
			assert(float(received["day"]) == original_day and received["temperature_bias"].max() == 0)
			assert(received["rain"] == original_state["rain"] and received["moisture"] == original_state["moisture"])
	await bridge.shutdown()
	assert(bridge._pid == -1)
	bridge.queue_free()
	view.queue_free()
	await process_frame
	# Construct the actual desktop UI too; static checks alone cannot catch null controls.
	print("[SMOKE] desktop startup")
	var session_root := ProjectSettings.globalize_path("user://native-smoke/%d" % Time.get_ticks_usec())
	DirAccess.make_dir_recursive_absolute(session_root)
	var backup_folder := session_root.path_join("autosaves")
	var test_preferences := session_root.path_join("preferences.cfg")
	var app := Application.new()
	app.autosave_directory = backup_folder
	app.preferences_path = test_preferences
	app.size = Vector2(1440, 960)
	root.add_child(app)
	deadline = Time.get_ticks_msec() + 15000
	while (app.snapshot.is_empty() or not app.save_panel.session_ready or app.snapshot.get("paused", true)) and Time.get_ticks_msec() < deadline:
		await process_frame
	if not app.save_panel.session_ready or app.snapshot.is_empty():
		print("[SMOKE] startup diagnostics: ", JSON.stringify({"phase": app.save_panel._phase, "ready": app.bridge.is_ready, "broken": app.bridge._broken, "pending": app.bridge._pending_command, "queue": app.bridge._queue, "waiting": app.bridge._waiting, "snapshot_day": app.snapshot.get("day"), "paused": app.snapshot.get("paused"), "error": app.error_label.text, "core_stderr": app.bridge._diagnostics, "records": app.save_panel._records, "panel_status": app.save_panel._status.text}))
	assert(app.save_panel.session_ready and not app.snapshot.is_empty(), "Desktop UI startup/recovery check did not finish")
	app.save_panel.enabled = false
	assert(app.brush_select.selected == 0 and app.undo_button.disabled)
	assert(app.lineage_panel._list.item_count == app.snapshot["lineages"].size())
	var family: Dictionary = app.snapshot["lineages"][0]
	app.focus_lineage(int(family["id"]))
	assert(app.map_view.track_lineage and app.map_view.tracked_lineage == int(family["id"]))
	assert(app.lineage_panel._tracking.button_pressed)
	assert(app.inspector.text.contains("Панцирь") and app.inspector.text.contains("Влага"))
	for observed: Dictionary in app.snapshot["creatures"]:
		if observed.get("behavior") is Dictionary:
			app.map_view.select_creature(int(observed["id"]))
			assert(app.inspector.text.contains("ВХОДЫ СЕТИ") and app.inspector.text.contains("ВЫХОДЫ СЕТИ"))
			break
	assert(app.behavior_text({"behavior": null}).contains("ещё нет шага"))
	assert(app.brush_select.item_count == 13)
	app.brush_select.select(5)
	app.update_brush()
	assert(app.map_view.brush_kind == "warm")
	var escape := InputEventKey.new()
	escape.pressed = true
	escape.keycode = KEY_ESCAPE
	app._unhandled_key_input(escape)
	assert(app.map_view.brush_kind == "observe")
	app.send_command("world", {"seed": 123, "population": 8})
	deadline = Time.get_ticks_msec() + 15000
	while int(app.snapshot["config"]["seed"]) != 123 and Time.get_ticks_msec() < deadline:
		await process_frame
	app.send_command("control", {"paused": true})
	while not app.snapshot["paused"] and Time.get_ticks_msec() < deadline:
		await process_frame
	assert(app.snapshot["paused"])
	deadline = Time.get_ticks_msec() + 15000
	print("[SMOKE] autosave")
	app.save_panel.request_save()
	while (app.save_panel._records.size() != 1 or app.save_panel._saving) and Time.get_ticks_msec() < deadline:
		await process_frame
	assert(app.save_panel._records.size() == 1 and not app.save_panel._saving)
	var saved_day := float(app.save_panel._records[0]["day"])
	app.save_panel.enabled = true
	app.save_panel.interval = 30
	app.save_panel._elapsed = 30
	app.save_panel._process(0.1)
	assert(not app.save_panel._saving, "Unchanged paused world must not be rewritten")
	var c: Dictionary = app.snapshot["creatures"][0]
	app.send_command("brush", {"kind": "warm", "x": c["x"], "y": c["y"]})
	while (not app.snapshot["sandbox"]["can_undo"] or app.save_panel._saving or app.save_panel._records.size() < 2) and Time.get_ticks_msec() < deadline:
		await process_frame
	assert(app.save_panel._records.size() == 2 and app.snapshot["sandbox"]["can_undo"])
	app.save_panel.enabled = false
	app.save_panel._persist_settings()
	var saved_preferences := ConfigFile.new()
	assert(saved_preferences.load(test_preferences) == OK)
	assert(saved_preferences.get_value("autosave", "interval") == 30)
	assert(saved_preferences.get_value("autosave", "enabled") == false)
	app.send_command("single_step", {})
	while float(app.snapshot["day"]) <= saved_day and Time.get_ticks_msec() < deadline:
		await process_frame
	deadline = Time.get_ticks_msec() + 15000
	app.save_panel._slots.select(1)  # Older, unheated checkpoint.
	app.save_panel.request_restore()
	assert(app.save_panel._dialog.visible and not app.save_panel.session_ready)
	app.save_panel._dialog.hide()
	app.save_panel._confirm_restore()
	while not app.save_panel.session_ready and Time.get_ticks_msec() < deadline:
		await process_frame
	assert(app.save_panel.session_ready and app.snapshot["paused"])
	assert(float(app.snapshot["day"]) == saved_day and app.snapshot["temperature_bias"].max() == 0)
	app.set_controls_enabled(false)
	await app.bridge.shutdown()
	app.queue_free()
	await process_frame
	# A second real app instance must ASK, not silently replace or overwrite a slot.
	print("[SMOKE] restart consent")
	var resumed := Application.new()
	resumed.autosave_directory = backup_folder
	resumed.preferences_path = test_preferences
	resumed.size = Vector2(1440, 960)
	root.add_child(resumed)
	deadline = Time.get_ticks_msec() + 15000
	while not resumed.save_panel._dialog.visible and Time.get_ticks_msec() < deadline:
		await process_frame
	assert(resumed.save_panel._dialog.visible and not resumed.save_panel.session_ready)
	assert(not resumed.save_panel.enabled and resumed.save_panel.interval == 30)
	assert(resumed.snapshot["paused"] and int(resumed.snapshot["config"]["seed"]) == 42)
	resumed.save_panel._dialog.hide()
	resumed.save_panel._confirm_restore()
	while not resumed.save_panel.session_ready and Time.get_ticks_msec() < deadline:
		await process_frame
	assert(resumed.save_panel.session_ready and resumed.snapshot["paused"])
	assert(int(resumed.snapshot["config"]["seed"]) == 123 and resumed.snapshot["temperature_bias"].max() > 0)
	resumed.set_controls_enabled(false)
	await resumed.bridge.shutdown()
	resumed.queue_free()
	await process_frame
	for filename: String in ["slot-1.biosphere", "slot-2.biosphere", "slot-3.biosphere", ".write.lock"]:
		DirAccess.remove_absolute(backup_folder.path_join(filename))
	DirAccess.remove_absolute(backup_folder)
	DirAccess.remove_absolute(test_preferences)
	DirAccess.remove_absolute(session_root)
	print("PASS: planet, meshes, layers, zoom, bundled core, sandbox IPC/undo/step, body genes, lineage follow, weather, desktop toolbox, autosave timer/rotation/selection/restart consent, shutdown")
	quit(0)

func _capture(view: PlanetView, folder: String, name: String) -> void:
	await RenderingServer.frame_post_draw
	DirAccess.make_dir_recursive_absolute(folder)
	var image := view._viewport.get_texture().get_image()
	assert(not image.is_empty())
	assert(image.save_png(folder.path_join(name + ".png")) == OK)
