# Ключ OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Основная модель. При ошибке сервер сам переберёт список запасных.
LORIA_MODEL=google/gemini-2.5-flash

# Порт и хост
PORT=3000
HOST=0.0.0.0

# Демо-режим без ИИ: 1 — включён, 0 — выключен, auto — только если нет ключа
LORIA_DEMO=auto

# Дневной лимит запросов к модели на одну игру (защита кошелька)
LORIA_DAILY_REQUESTS=200
