# Ключ OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Основная модель. При ошибке сервер сам переберёт список запасных.
LORIA_MODEL=google/gemini-2.5-flash
# Дополнительные модели через запятую (необязательно)
# LORIA_MODELS=
# Свой адрес API, если нужен прокси (необязательно)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Строгий аудит: вторая модель проверяет каждый ход (дороже)
# LORIA_AI_AUDIT=0

# Порт и хост
PORT=3000
HOST=0.0.0.0

# Демо-режим без ИИ: 1 — включён, 0 — выключен, auto — только если нет ключа
LORIA_DEMO=auto

# Дневной лимит запросов к модели на одну игру (защита кошелька)
LORIA_DAILY_REQUESTS=200

# Telegram-бот (необязательно), токен от @BotFather
# TELEGRAM_BOT_TOKEN=
# Публичный адрес приложения — бот даёт на него ссылку
# LORIA_PUBLIC_URL=https://your-domain.example
